# DeepGuard backend — copy to .env and fill in real values.
# (Used by docker-compose.yml. This is separate from the frontend's
# deepguard-frontend/.env.local.)

# Comma-separated CORS origins. Keep "*" while testing connectivity,
# then tighten to the exact Vercel frontend URL, e.g.
# ALLOW_ORIGINS=https://deepguard.vercel.app
ALLOW_ORIGINS=*

# Local path of model checkpoints INSIDE the container.
# Must match the bind mount in docker-compose.yml. Do not change
# unless you change the mount too.
WEIGHTS_DIR=/weights

# Fail fast at boot if any .pth checkpoint is missing.
# Keep at 1 in production so the API never serves verdicts
# from randomly-initialized networks.
REQUIRE_WEIGHTS=1
